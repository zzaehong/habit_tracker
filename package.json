{
  "name": "habit-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "npm test && npm run build",
    "server": "tsx server/index.ts",
    "test:e2e": "playwright test",
    "ocr:build": "mkdir -p runtime/swift-cache && swiftc -module-cache-path runtime/swift-cache scripts/ocr.swift -o runtime/ocr"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.6",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
